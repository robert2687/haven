# Port to run the server on
PORT=3000

# Google Gemini API Key for companion messaging and TTS
GEMINI_API_KEY=

# AI provider: 'gemini' (default) or 'openrouter'
# AI_PROVIDER=gemini

# OpenRouter API key (required when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Chat model override (defaults depend on AI_PROVIDER)
# CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_PROVIDER_ONLY=thinkingmachines/nvfp4
# Reasoning subagent model (NVIDIA endpoint, no fallbacks)
# SUBAGENT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# SUBAGENT_PROVIDER_ONLY=nvidia
# OPENROUTER_SITE_URL=http://localhost:3000
